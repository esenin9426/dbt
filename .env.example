# Скопируйте этот файл в .env перед запуском `docker compose up`
#   cp .env.example .env

# --- Postgres (хранилище данных для проекта) ---
POSTGRES_USER=dbt_user
POSTGRES_PASSWORD=dbt_password
POSTGRES_DB=dbt_demo
POSTGRES_PORT=5432

# --- dbt ---
# Используется в dbt_project/profiles/profiles.yml
DBT_PROFILES_DIR=/root/.dbt
